<%- include('partials/header') %>

<main class="content">
  <p class="breadcrumb"><a href="/projects">Projects</a> / New</p>
  <h1><%= title %></h1>

  <% if (errors.length > 0) { %>
    <div class="error-summary" role="alert">
      <h2>Please correct the following:</h2>
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form class="project-form" action="/new-project" method="post">
    <label for="title">
      <span>Project Title</span>
      <input type="text" id="title" name="title" value="<%= project.title || '' %>" maxlength="200" required>
    </label>

    <label for="description">
      <span>Description</span>
      <textarea id="description" name="description" rows="6" maxlength="1000" required><%= project.description || '' %></textarea>
    </label>

    <label for="location">
      <span>Location</span>
      <input type="text" id="location" name="location" value="<%= project.location || '' %>" maxlength="200" required>
    </label>

    <label for="date">
      <span>Date</span>
      <input type="date" id="date" name="date" value="<%= project.date || '' %>" required>
    </label>

    <label for="organizationId">
      <span>Partner Organization</span>
      <select id="organizationId" name="organizationId" required>
        <option value="">Select an organization</option>
        <% organizations.forEach(organization => { %>
          <option
            value="<%= organization.organization_id %>"
            <%= Number(organization.organization_id) === Number(project.organizationId || project.organization_id) ? 'selected' : '' %>
          >
            <%= organization.name %>
          </option>
        <% }); %>
      </select>
    </label>

    <div class="actions">
      <button class="button" type="submit">Create Project</button>
      <a class="button secondary" href="/projects">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
