<%- include('partials/header') %>

<main class="content">
  <p class="breadcrumb"><a href="/">Home</a> / Dashboard</p>
  <h1>Dashboard</h1>

  <section class="card">
    <h2>Account</h2>
    <p>Name: <%= name %></p>
    <p>Email: <%= email %></p>
  </section>

  <section>
    <h2>My Volunteer Projects</h2>
    <% if (volunteeredProjects.length === 0) { %>
      <p>You have not signed up to volunteer for any projects yet.</p>
    <% } else { %>
      <ul class="project-list">
        <% volunteeredProjects.forEach(project => { %>
          <li>
            <a class="project-summary" href="/project/<%= project.project_id %>">
              <time datetime="<%= project.date.toISOString ? project.date.toISOString().slice(0, 10) : project.date %>">
                <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              </time>
              <span><%= project.title %></span>
            </a>
            <span>with <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></span>
            <form class="inline-form" action="/project/<%= project.project_id %>/volunteer/remove" method="post">
              <input type="hidden" name="returnTo" value="dashboard">
              <button class="button secondary" type="submit">Remove Me</button>
            </form>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <% if (user && user.role_name === 'admin') { %>
    <div class="actions">
      <a class="button" href="/users">View Registered Users</a>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
