<%- include('partials/header') %>

<main class="content">
  <p class="breadcrumb"><a href="/">Home</a> / Dashboard</p>
  <h1>Dashboard</h1>

  <section class="card">
    <h2>Account</h2>
    <p>Name: <%= name %></p>
    <p>Email: <%= email %></p>
  </section>

  <% if (user && user.role_name === 'admin') { %>
    <div class="actions">
      <a class="button" href="/users">View Registered Users</a>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
