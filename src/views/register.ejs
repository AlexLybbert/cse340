<%- include('partials/header') %>

<main class="content">
  <p class="breadcrumb"><a href="/">Home</a> / Register</p>
  <h1><%= title %></h1>

  <% if (errors.length > 0) { %>
    <div class="error-summary" role="alert">
      <h2>Please correct the following:</h2>
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form class="project-form" action="/register" method="post">
    <label for="name">
      <span>Name</span>
      <input type="text" id="name" name="name" value="<%= user.name || '' %>" maxlength="100" required>
    </label>

    <label for="email">
      <span>Email</span>
      <input type="email" id="email" name="email" value="<%= user.email || '' %>" maxlength="100" required>
    </label>

    <label for="password">
      <span>Password</span>
      <input type="password" id="password" name="password" minlength="8" maxlength="72" required>
    </label>

    <div class="actions">
      <button class="button" type="submit">Create Account</button>
      <a class="button secondary" href="/">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
