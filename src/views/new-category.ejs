<%- include('partials/header') %>

<main class="content">
  <p class="breadcrumb"><a href="/categories">Categories</a> / New</p>
  <h1><%= title %></h1>

  <% if (errors.length > 0) { %>
    <div class="error-summary" role="alert">
      <h2>Please correct the following:</h2>
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form class="project-form" action="/new-category" method="post">
    <label for="name">
      <span>Category Name</span>
      <input type="text" id="name" name="name" value="<%= category.name || '' %>" maxlength="100" required>
    </label>

    <div class="actions">
      <button class="button" type="submit">Create Category</button>
      <a class="button secondary" href="/categories">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
