<%- include('partials/header') %>

<main class="content">
  <h1><%= title %></h1>
  <p><a class="button" href="/new-project">Add Service Project</a></p>

  <% if (projects.length === 0) { %>
    <p>No upcoming service projects are available right now.</p>
  <% } else { %>
    <ul class="project-list">
      <% projects.forEach(project => { %>
        <li>
          <a class="project-summary" href="/project/<%= project.project_id %>">
            <time datetime="<%= project.date.toISOString ? project.date.toISOString().slice(0, 10) : project.date %>">
              <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </time>
            <span><%= project.title %></span>
          </a>
          <span>with <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></span>
        </li>
      <% }); %>
    </ul>
  <% } %>
</main>

<%- include('partials/footer') %>
